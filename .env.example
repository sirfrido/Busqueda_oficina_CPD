# --- Correo de salida (informe diario) --------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=tu_usuario@tudominio.com
SMTP_PASSWORD=contraseña_de_aplicacion
SMTP_TLS=1
EMAIL_REMITENTE=agente-oficinas@tudominio.com
EMAIL_DESTINATARIOS=alex@hampastudio.com
EMAIL_RESPONDER_A=alex@hampastudio.com

# --- Identidad para los emails a la propiedad -------------------------------
CONTACTO_NOMBRE=Alex
CONTACTO_EMPRESA=
CONTACTO_TELEFONO=
EMAIL_CONTACTO=alex@hampastudio.com

# --- Claude (cualificación de anuncios) -------------------------------------
ANTHROPIC_API_KEY=
MODELO_LLM=claude-opus-5
LLM_EFFORT=medium
LLM_ACTIVO=1
LLM_MAX_ANUNCIOS=40

# --- Idealista API (opcional pero muy recomendable) -------------------------
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=

# --- Contacto con la propiedad: borrador | auto | off ------------------------
MODO_CONTACTO=borrador
